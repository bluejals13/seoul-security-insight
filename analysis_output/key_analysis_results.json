  "key_insights": [
    {
      "id": "INSIGHT_01",
      "title": "범죄 건수 1위와 인구 대비 범죄율 1위 자치구의 괴리",
      "summary": "절대 범죄 발생건수 1위는 강남구(6,725건)이지만, 상주인구 1만 명당 범죄율 1위는 중구(454.65건) 및 종로구(383.02건)로 나타납니다. 상주인구가 적고 유동인구 및 유흥·상업지구가 밀집한 도심 자치구의 착시현상 분석이 필수적입니다.",
      "metrics": {
        "gangnam_abs": 6725,
        "junggu_per_10k": 454.65,
        "jongno_per_10k": 383.02
      }
    },
    {
      "id": "INSIGHT_02",
      "title": "5대 범죄 중 폭력과 절도가 전체 범죄의 95.8% 차지",
      "summary": "2024년 서울시 5대 범죄 총 80,819건 중 폭력(39,554건, 48.9%)과 절도(37,867건, 46.9%)가 절대 다수를 차지합니다. 성범죄는 3,248건(4.0%), 살인 149건(0.18%), 강도 118건(0.15%)순입니다.",
      "metrics": {
        "violence_pct": 48.9,
        "theft_pct": 46.9,
        "sexual_pct": 4.0
      }
    },
    {
      "id": "INSIGHT_03",
      "title": "가로등 수와 범죄 발생량 간 비선형성 및 데이터 이상치 관찰",
      "summary": "가로등 수와 범죄 발생량 간 상관계수는 0.22~0.33 수준의 약한 양의 상관관계를 보이나, 이는 인구 밀집 지역(강남, 관악 등)에 가로등 인프라가 집중 배치되어 나타나는 교란변수(인구수/유동인구) 효과입니다. 또한 중랑구 등 일부 자치구의 가로등 데이터 수집 누락(0건) 이상치가 존재하여 데이터 한계 명시가 필요합니다.",
      "metrics": {
        "corr_abs": 0.56,
        "corr_per_10k": 0.12
      }
    }
  ]
