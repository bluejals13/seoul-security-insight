from fastapi import FastAPI

from backend.routers.convert import router as convert_router
from backend.routers.captcha import router as captcha_router
from backend.routers.webtoon import router as webtoon_router


app = FastAPI(
    title="BizTalk Antigravity API"
)


app.include_router(
    convert_router,
    prefix="/api"
)

app.include_router(
    captcha_router,
    prefix="/api"
)

app.include_router(
    webtoon_router,
    prefix="/api"
)


@app.get("/api/health")
async def health():
    return {
        "success": True,
        "message": "BizTalk API is running"
    }